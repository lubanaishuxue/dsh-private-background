{
  "name": "dsh-private-background",
  "version": "1.3.37",
  "description": "为 DSH 界面设置自定义背景：本地图片、动图（GIF / 动态 WebP / APNG）、视频、渐变或纯色，可调模糊、压暗、取景位置，以及面板 / 对话区 / 输入框不透明度，输入框与代码块可切换液态玻璃质感。默认只作用于工作区，左侧对话栏保持原样。",
  "type": "module",
  "license": "MIT",
  "author": "lubanaishuxue",
  "homepage": "https://github.com/lubanaishuxue/dsh-private-background#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lubanaishuxue/dsh-private-background.git"
  },
  "bugs": {
    "url": "https://github.com/lubanaishuxue/dsh-private-background/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "wallpaper",
    "background",
    "glassmorphism"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cost-meter-patch.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
